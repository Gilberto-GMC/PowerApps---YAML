                                    RadiusBottomRight: =0
                                    RadiusTopLeft: =0
                                    RadiusTopRight: =0
                                    Width: =Parent.Width
                                  Children:
                                    - btnVoltarDetalhesAvsec:
                                        Control: Button@0.0.45
                                        Properties:
                                          Appearance: ='ButtonCanvas.Appearance'.Secondary
                                          BorderRadius: =0
                                          Font: =Font.'Segoe UI'
                                          FontSize: =12
                                          FontWeight: =FontWeight.Semibold
                                          Icon: ="ArrowLeft"
                                          Layout: ='ButtonCanvas.Layout'.IconBefore
                                          OnSelect: |-
                                            =UpdateContext({var_visible: "Registros", var_visibleDesdobramento: false})
                                          Text: ="Voltar aos registros"
                                          Width: =170
                                    - DetailsHeaderTextAvsec:
                                        Control: GroupContainer@1.5.0
