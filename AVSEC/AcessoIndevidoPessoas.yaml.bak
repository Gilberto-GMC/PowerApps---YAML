                                                AutoHeight: =true
                                                Color: =RGBA(148, 163, 184, 1)
                                                Font: =Font.'Segoe UI'
                                                Size: =9
                                                Text: =var_ocorrenciaAvsec.aeroporto & " • " & var_ocorrenciaAvsec.tipo_acesso
                                                Width: =Parent.Width
                                    - btnEditarDetalhesAvsec:
                                        Control: Button@0.0.45
                                        Properties:
