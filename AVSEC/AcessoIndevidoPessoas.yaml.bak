                                          - btnCancelarOcorrenciaAvsec:
                                              Control: Button@0.0.45
                                              Properties:
                                                Appearance: ='ButtonCanvas.Appearance'.Secondary
                                                BorderRadius: =0
                                                Font: =Font.'Segoe UI'
                                                FontSize: =12
                                                FontWeight: =FontWeight.Semibold
                                                Icon: ="Dismiss"
                                                OnSelect: |-
                                                  =ResetForm(FormAvsecOcorrencia_1);
                                                  If(
                                                      var_acao = "edit",
                                                      UpdateContext({var_visible: "Detalhes", var_acao: "view"}),
                                                      UpdateContext({var_visible: "Registros", var_acao: "view"})
                                                  )
                                                Text: ="Cancelar"
                                                Width: =115
                                          - btnSalvarOcorrenciaAvsec:
                                              Control: Button@0.0.45
                                              Properties:
                                                Appearance: ='ButtonCanvas.Appearance'.Primary
                                                BorderRadius: =0
                                                DisplayMode: =If(var_visibleProcessando, DisplayMode.Disabled, DisplayMode.Edit)
                                                Font: =Font.'Segoe UI'
                                                FontSize: =12
                                                FontWeight: =FontWeight.Semibold
                                                Icon: ="Save"
                                                Layout: ='ButtonCanvas.Layout'.IconBefore
                                                OnSelect: |-
                                                  =If(
                                                      !FormAvsecOcorrencia_1.Valid,
                                                      Notify("Preencha todos os campos obrigatórios.", NotificationType.Warning, 3500),
                                                      !IsBlank(dpTerminoAvsec.SelectedDate) And termino_DataCardAvsec.Update < inicio_DataCardAvsec.Update,
                                                      Notify("A data de término não pode ser anterior à data de início.", NotificationType.Warning, 3500),
                                                      And(
                                                          cmbAreaAvsec.Selected.Value = "ars_area_restrita_seguranca",
                                                          cmbTipoAcessoAvsec.Selected.Value = "acesso_indevido",
                                                          IsBlank(cmbVarreduraAvsec.Selected.Value)
                                                      ),
                                                      Notify("Informe se a varredura em ARS foi realizada.", NotificationType.Warning, 3500),
                                                      Len(Trim(txtDescricaoAvsec.Text)) < 10,
                                                      Notify("A descrição deve possuir pelo menos 10 caracteres.", NotificationType.Warning, 3500),
                                                      Len(Trim(txtAcaoImediataAvsec.Text)) < 10,
                                                      Notify("A ação imediata deve possuir pelo menos 10 caracteres.", NotificationType.Warning, 3500),
                                                      UpdateContext({var_visibleProcessando: true});
                                                      SubmitForm(FormAvsecOcorrencia_1)
                                                  )
                                                Text: =If(var_acao = "edit", "Salvar alterações", "Registrar ocorrência")
                                                Width: =180
