                                                Font: =Font.'Segoe UI'
                                                FontWeight: =FontWeight.Bold
                                                Size: =15
                                                Text: ="OCORRÊNCIA"
                                                Width: =Parent.Width
                                          - lblDetailsSubtitleAvsec:
                                              Control: Label@2.5.1
