                                                      AutoHeight: =true
                                                      Color: =RGBA(0, 0, 0, 1)
                                                      Font: =Font.'Segoe UI'
                                                      FontWeight: =FontWeight.Semibold
                                                      Size: =8
                                                      Text: =If(CountRows(ThisItem.Anexos) > 0, "Possui anexo(s)", "")
