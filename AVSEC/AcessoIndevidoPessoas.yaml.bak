                                                Text: ="Nenhum desdobramento adicional registrado."
                                                Visible: =CountRows(galDesdobramentosAvsec.AllItems) = 0
                                                Width: =Parent.Width
                                          - DesdobFormCardAvsec:
                                              Control: GroupContainer@1.5.0
                                              Variant: AutoLayout
                                              Properties:
