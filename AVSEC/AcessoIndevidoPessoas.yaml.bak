                                                            DisplayName: ="categoria"
                                                            Fill: =RGBA(255, 255, 255, 1)
                                                            Height: =105
                                                            MaxLength: =DataSourceInfo([@tb_avsecDesdobramentos], DataSourceInfo.MaxLength, categoria)
                                                            Required: =true
                                                            Update: =cmbCategoriaDesdobAvsec.Selected.Value
                                                            Width: =Parent.Width
                                                            X: =0
                                                            Y: =2
                                                          Children:
                                                            - lblCategoriaDesdobAvsec:
                                                                Control: Label@2.5.1
                                                                Properties:
                                                                  AutoHeight: =true
                                                                  Color: =RGBA(51, 65, 85, 1)
                                                                  Font: =Font.'Segoe UI'
                                                                  FontWeight: =FontWeight.Semibold
                                                                  Size: =10
                                                                  Text: ="Categoria" & " *"
                                                                  Width: =Parent.Width - 32
                                                                  X: =16
                                                                  Y: =10
                                                            - cmbCategoriaDesdobAvsec:
                                                                Control: Classic/ComboBox@2.4.0
                                                                MetadataKey: FieldValue
                                                                Properties:
                                                                  BorderColor: =RGBA(229, 229, 229, 1)
                                                                  BorderThickness: =1
                                                                  ChevronBackground: =RGBA(248, 250, 252, 1)
                                                                  ChevronFill: =RGBA(0, 0, 0, 1)
                                                                  DefaultSelectedItems: |-
                                                                    =If(IsBlank(Parent.Default), Blank(), Filter(Table({Value: "acao_corretiva", Label: "Ação corretiva"}, {Value: "acao_preventiva", Label: "Ação preventiva"}, {Value: "analise_avsec", Label: "Análise AVSEC"}, {Value: "classificacao_dsac", Label: "Classificação DSAC"}, {Value: "tratativa_bloco", Label: "Tratativa do bloco"}, {Value: "evidencia_comprovacao", Label: "Evidência / comprovação"}, {Value: "encerramento", Label: "Encerramento"}, {Value: "outro", Label: "Outro"}), Value = Parent.Default))
                                                                  DisplayFields: =["Label"]
                                                                  Fill: =RGBA(255, 255, 255, 1)
                                                                  Font: =Font.'Segoe UI'
                                                                  Height: =38
                                                                  IsSearchable: =false
                                                                  Items: |-
                                                                    =Table({Value: "acao_corretiva", Label: "Ação corretiva"}, {Value: "acao_preventiva", Label: "Ação preventiva"}, {Value: "analise_avsec", Label: "Análise AVSEC"}, {Value: "classificacao_dsac", Label: "Classificação DSAC"}, {Value: "tratativa_bloco", Label: "Tratativa do bloco"}, {Value: "evidencia_comprovacao", Label: "Evidência / comprovação"}, {Value: "encerramento", Label: "Encerramento"}, {Value: "outro", Label: "Outro"})
                                                                  NoSelectionText: ="Selecione"
                                                                  PaddingLeft: =8
                                                                  SearchFields: =["Label"]
                                                                  SelectMultiple: =false
                                                                  Size: =10
                                                                  Width: =Parent.Width - 32
                                                                  X: =16
                                                                  Y: =35
                                                            - errCategoriaDesdobAvsec:
                                                                Control: Label@2.5.1
                                                                MetadataKey: ErrorMessage
                                                                Properties:
                                                                  AutoHeight: =true
                                                                  Color: =RGBA(185, 28, 28, 1)
                                                                  Font: =Font.'Segoe UI'
                                                                  FontWeight: =FontWeight.Semibold
                                                                  Live: =Live.Assertive
                                                                  PaddingBottom: =0
                                                                  PaddingLeft: =0
                                                                  PaddingRight: =0
                                                                  PaddingTop: =0
                                                                  Size: =9
                                                                  Text: =Parent.Error
                                                                  Visible: =And(Parent.DisplayMode = DisplayMode.Edit, !IsBlank(Parent.Error))
                                                                  Width: =Parent.Width - 32
                                                                  X: =16
                                                                  Y: =78
                                                      - conteudo_DataCardAvsec:
                                                          Control: TypedDataCard@1.0.7
                                                          Variant: ClassicTextualEdit
                                                          Properties:
                                                            BorderColor: =RGBA(0, 0, 0, 0)
                                                            DataField: ="conteudo"
