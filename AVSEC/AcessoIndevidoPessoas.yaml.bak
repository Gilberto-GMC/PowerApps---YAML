                                                      RadiusTopRight: =0
                                                      Width: =Parent.Width
                                                    Children:
                                                      - lblDesdobFormTitleAvsec:
                                                          Control: Label@2.5.1
                                                          Properties:
                                                            AutoHeight: =true
                                                            Color: =RGBA(2, 16, 59, 1)
                                                            FillPortions: =1
                                                            Font: =Font.'Segoe UI'
                                                            FontWeight: =FontWeight.Bold
                                                            Text: ="NOVO DESDOBRAMENTO"
                                                      - btnFecharDesdobAvsec:
                                                          Control: Button@0.0.45
                                                          Properties:
                                                            Appearance: ='ButtonCanvas.Appearance'.Secondary
                                                            BorderRadius: =0
                                                            Font: =Font.'Segoe UI'
                                                            FontSize: =12
                                                            FontWeight: =FontWeight.Semibold
                                                            Icon: ="Dismiss"
                                                            OnSelect: |-
                                                              =UpdateContext({var_visibleDesdobramento: false}); ResetForm(FormAvsecDesdobramento_1)
                                                            Text: ="Fechar"
                                                            Width: =100
                                                - FormAvsecDesdobramento_1:
                                                    Control: Form@2.4.4
                                                    Variant: Classic
                                                    Layout: Vertical
                                                    Properties:
                                                      BorderColor: =RGBA(0, 0, 0, 0)
                                                      DataSource: =tb_avsecDesdobramentos
                                                      Fill: =RGBA(255, 255, 255, 1)
                                                      Height: =570
                                                      Item: =var_dados_desdobramento
                                                      NumberOfColumns: =1
                                                      OnFailure: |-
                                                        =UpdateContext({var_processandoDesdobramento: false});
                                                        Notify(
                                                            "Não foi possível salvar o desdobramento. " & Coalesce(FormAvsecDesdobramento_1.Error, "Revise os campos e tente novamente."),
                                                            NotificationType.Error,
                                                            5000
                                                        )
                                                      OnSuccess: |-
                                                        =If(
                                                            var_ocorrenciaAvsec.status = "aguardando_analise_avsec",
                                                            Set(
                                                                var_ocorrenciaAvsec,
                                                                Patch(
                                                                    tb_avsecOcorrencias,
                                                                    var_ocorrenciaAvsec,
                                                                    {status: "em_analise_avsec"}
                                                                )
                                                            )
                                                        );
                                                        UpdateContext(
                                                            {
                                                                var_processandoDesdobramento: false,
                                                                var_visibleDesdobramento: false
                                                            }
                                                        );
                                                        ResetForm(FormAvsecDesdobramento_1);
                                                        NewForm(FormAvsecDesdobramento_1);
                                                        Refresh(tb_avsecDesdobramentos);
                                                        Refresh(tb_avsecOcorrencias);
                                                        Notify("Desdobramento registrado.", NotificationType.Success, 3000)
                                                      Width: =Parent.Width
                                                    Children:
                                                      - id_fk_ocorrencia_DataCardAvsec:
                                                          Control: TypedDataCard@1.0.7
                                                          Variant: ClassicNumberEdit
                                                          Properties:
                                                            BorderColor: =RGBA(0, 0, 0, 0)
                                                            DataField: ="id_fk_ocorrencia"
                                                            Default: =ThisItem.id_fk_ocorrencia
                                                            DisplayName: ="id_fk_ocorrencia"
                                                            Fill: =RGBA(255, 255, 255, 1)
                                                            Required: =true
                                                            Update: =var_ocorrenciaAvsec.ID
                                                            Visible: =false
                                                            Width: =Parent.Width
                                                            X: =0
                                                            Y: =0
                                                      - aeroporto_desdob_DataCardAvsec:
