                                                            Appearance: ='ButtonCanvas.Appearance'.Primary
                                                            BorderRadius: =0
                                                            DisplayMode: =If(var_processandoDesdobramento, DisplayMode.Disabled, DisplayMode.Edit)
                                                            Font: =Font.'Segoe UI'
                                                            FontSize: =12
                                                            FontWeight: =FontWeight.Semibold
                                                            Icon: ="Save"
                                                            Layout: ='ButtonCanvas.Layout'.IconBefore
                                                            OnSelect: |-
                                                              =If(
                                                                  !FormAvsecDesdobramento_1.Valid Or Len(Trim(txtConteudoDesdobAvsec.Text)) < 5,
                                                                  Notify("Informe a categoria e descreva o desdobramento com pelo menos 5 caracteres.", NotificationType.Warning, 3500),
                                                                  UpdateContext({var_processandoDesdobramento: true});
                                                                  SubmitForm(FormAvsecDesdobramento_1)
                                                              )
                                                            Text: ="Salvar desdobramento"
                                                            Width: =190
                                    - AnalysisCardAvsec:
                                        Control: GroupContainer@1.5.0
                                        Variant: AutoLayout
                                        Properties:
                                          BorderColor: =RGBA(229, 229, 229, 1)
                                          BorderThickness: =1
                                          DropShadow: =DropShadow.None
                                          Fill: =RGBA(255, 255, 255, 1)
                                          LayoutDirection: =LayoutDirection.Vertical
                                          LayoutGap: =10
                                          LayoutMinWidth: =0
                                          PaddingBottom: =14
                                          PaddingLeft: =14
                                          PaddingRight: =14
                                          PaddingTop: =10
                                          RadiusBottomLeft: =0
                                          RadiusBottomRight: =0
                                          RadiusTopLeft: =0
                                          RadiusTopRight: =0
                                          Width: =Parent.Width
                                        Children:
                                          - AnalysisHeaderAvsec:
                                              Control: GroupContainer@1.5.0
                                              Variant: AutoLayout
                                              Properties:
                                                DropShadow: =DropShadow.None
                                                FillPortions: =0
                                                Height: =46
                                                LayoutAlignItems: =LayoutAlignItems.Center
                                                LayoutDirection: =LayoutDirection.Horizontal
                                                LayoutGap: =8
                                                RadiusBottomLeft: =0
                                                RadiusBottomRight: =0
                                                RadiusTopLeft: =0
                                                RadiusTopRight: =0
                                              Children:
                                                - icoAnalysisAvsec:
                                                    Control: Icon@0.0.7
                                                    Properties:
                                                      Height: =24
                                                      Icon: ="ShieldCheckmark"
                                                      IconColor: =RGBA(0, 0, 0, 1)
                                                      IconStyle: ='Icon.IconStyle'.Outline
                                                      Width: =24
                                                - lblAnalysisTitleAvsec:
                                                    Control: Label@2.5.1
                                                    Properties:
                                                      AutoHeight: =true
                                                      Color: =RGBA(2, 16, 59, 1)
                                                      FillPortions: =1
                                                      Font: =Font.'Segoe UI'
                                                      FontWeight: =FontWeight.Bold
                                                      Text: ="ANÁLISE AVSEC"
                                          - AnalysisCurrentStatusAvsec:
                                              Control: GroupContainer@1.5.0
                                              Variant: AutoLayout
                                              Properties:
                                                DropShadow: =DropShadow.None
                                                FillPortions: =0
                                                Height: =62
                                                LayoutDirection: =LayoutDirection.Vertical
                                                LayoutGap: =4
                                                RadiusBottomLeft: =0
                                                RadiusBottomRight: =0
                                                RadiusTopLeft: =0
                                                RadiusTopRight: =0
                                              Children:
                                                - lblAnalysisCurrentStatusTitleAvsec:
                                                    Control: Label@2.5.1
                                                    Properties:
                                                      AutoHeight: =true
                                                      Color: =RGBA(148, 163, 184, 1)
                                                      Font: =Font.'Segoe UI'
                                                      FontWeight: =FontWeight.Semibold
                                                      Size: =8
                                                      Text: ="STATUS ATUAL"
                                                - lblAnalysisCurrentStatusValueAvsec:
                                                    Control: Label@2.5.1
                                                    Properties:
                                                      Align: =Align.Center
                                                      Color: =Switch(var_ocorrenciaAvsec.status, "encerrada", RGBA(22, 101, 52, 1), "arquivada_sem_dsac", RGBA(22, 101, 52, 1), "escalonada_ao_bloco", RGBA(185, 28, 28, 1), RGBA(0, 0, 0, 1))
                                                      Fill: =Switch(var_ocorrenciaAvsec.status, "encerrada", RGBA(220, 252, 231, 1), "arquivada_sem_dsac", RGBA(220, 252, 231, 1), "escalonada_ao_bloco", RGBA(254, 226, 226, 1), RGBA(248, 250, 252, 1))
                                                      Font: =Font.'Segoe UI'
                                                      FontWeight: =FontWeight.Semibold
                                                      Height: =32
                                                      Size: =9
                                                      Text: =Switch(var_ocorrenciaAvsec.status, "aguardando_analise_avsec", "Aguardando análise AVSEC", "em_analise_avsec", "Em análise AVSEC", "arquivada_sem_dsac", "Arquivada sem DSAC", "encaminhada_ao_bloco", "Encaminhada ao bloco", "escalonada_ao_bloco", "Escalonada ao bloco", "em_elaboracao_dsac", "Em elaboração DSAC", "enviada_anac", "Enviada à ANAC", "encerrada", "Encerrada", Coalesce(var_ocorrenciaAvsec.status, "Não definido"))
                                                      Width: =Parent.Width
                                          - AnalysisStatusFieldAvsec:
                                              Control: GroupContainer@1.5.0
                                              Variant: ManualLayout
                                              Properties:
                                                DropShadow: =DropShadow.None
                                                FillPortions: =0
                                                Height: =76
                                                RadiusBottomLeft: =0
                                                RadiusBottomRight: =0
                                                RadiusTopLeft: =0
                                                RadiusTopRight: =0
                                              Children:
                                                - lblAnalysisStatusFieldAvsec:
                                                    Control: Label@2.5.1
                                                    Properties:
                                                      AutoHeight: =true
                                                      Color: =RGBA(2, 16, 59, 1)
                                                      Font: =Font.'Segoe UI'
                                                      FontWeight: =FontWeight.Semibold
                                                      Size: =9
                                                      Text: ="Novo status"
                                                      Width: =Parent.Width - 24
                                                      X: =12
                                                      Y: =3
                                                - cmbAnalysisStatusAvsec:
                                                    Control: Classic/ComboBox@2.4.0
                                                    Properties:
                                                      BorderColor: =RGBA(229, 229, 229, 1)
                                                      BorderThickness: =1
                                                      ChevronBackground: =RGBA(248, 250, 252, 1)
                                                      ChevronFill: =RGBA(0, 0, 0, 1)
                                                      DefaultSelectedItems: |-
                                                        =If(IsBlank(var_ocorrenciaAvsec.ID), Blank(), Filter(Table({Value: "aguardando_analise_avsec", Label: "Aguardando análise AVSEC"}, {Value: "em_analise_avsec", Label: "Em análise AVSEC"}, {Value: "arquivada_sem_dsac", Label: "Arquivada sem DSAC"}, {Value: "encaminhada_ao_bloco", Label: "Encaminhada ao bloco"}, {Value: "escalonada_ao_bloco", Label: "Escalonada ao bloco"}, {Value: "em_elaboracao_dsac", Label: "Em elaboração DSAC"}, {Value: "enviada_anac", Label: "Enviada à ANAC"}, {Value: "encerrada", Label: "Encerrada"}), Value = var_ocorrenciaAvsec.status))
                                                      DisplayFields: =["Label"]
                                                      Fill: =RGBA(255, 255, 255, 1)
                                                      Font: =Font.'Segoe UI'
                                                      Height: =38
                                                      IsSearchable: =false
                                                      Items: |-
                                                        =Table({Value: "aguardando_analise_avsec", Label: "Aguardando análise AVSEC"}, {Value: "em_analise_avsec", Label: "Em análise AVSEC"}, {Value: "arquivada_sem_dsac", Label: "Arquivada sem DSAC"}, {Value: "encaminhada_ao_bloco", Label: "Encaminhada ao bloco"}, {Value: "escalonada_ao_bloco", Label: "Escalonada ao bloco"}, {Value: "em_elaboracao_dsac", Label: "Em elaboração DSAC"}, {Value: "enviada_anac", Label: "Enviada à ANAC"}, {Value: "encerrada", Label: "Encerrada"})
                                                      PaddingLeft: =8
                                                      SearchFields: =["Label"]
                                                      SelectMultiple: =false
                                                      Size: =10
                                                      Width: =Parent.Width - 24
                                                      X: =12
                                                      Y: =27
                                          - AnalysisDsacFieldAvsec:
                                              Control: GroupContainer@1.5.0
                                              Variant: ManualLayout
                                              Properties:
                                                DropShadow: =DropShadow.None
                                                FillPortions: =0
                                                Height: =76
                                                RadiusBottomLeft: =0
                                                RadiusBottomRight: =0
                                                RadiusTopLeft: =0
                                                RadiusTopRight: =0
                                              Children:
                                                - lblAnalysisDsacFieldAvsec:
                                                    Control: Label@2.5.1
                                                    Properties:
                                                      AutoHeight: =true
                                                      Color: =RGBA(2, 16, 59, 1)
                                                      Font: =Font.'Segoe UI'
                                                      FontWeight: =FontWeight.Semibold
                                                      Size: =9
                                                      Text: ="Classificação DSAC"
                                                      Width: =Parent.Width - 24
                                                      X: =12
                                                      Y: =3
                                                - cmbAnalysisDsacAvsec:
                                                    Control: Classic/ComboBox@2.4.0
                                                    Properties:
                                                      BorderColor: =RGBA(229, 229, 229, 1)
                                                      BorderThickness: =1
                                                      ChevronBackground: =RGBA(248, 250, 252, 1)
                                                      ChevronFill: =RGBA(0, 0, 0, 1)
                                                      DefaultSelectedItems: |-
                                                        =If(IsBlank(var_ocorrenciaAvsec.ID), Blank(), Filter(Table({Value: "pendente", Label: "Pendente"}, {Value: "sim", Label: "Sim"}, {Value: "nao", Label: "Não"}), Value = Coalesce(var_ocorrenciaAvsec.gera_dsac, "pendente")))
                                                      DisplayFields: =["Label"]
                                                      Fill: =RGBA(255, 255, 255, 1)
                                                      Font: =Font.'Segoe UI'
                                                      Height: =38
                                                      IsSearchable: =false
                                                      Items: |-
                                                        =Table({Value: "pendente", Label: "Pendente"}, {Value: "sim", Label: "Sim"}, {Value: "nao", Label: "Não"})
                                                      PaddingLeft: =8
                                                      SearchFields: =["Label"]
                                                      SelectMultiple: =false
                                                      Size: =10
                                                      Width: =Parent.Width - 24
                                                      X: =12
                                                      Y: =27
                                          - AnalysisCsaFieldAvsec:
                                              Control: GroupContainer@1.5.0
                                              Variant: ManualLayout
                                              Properties:
                                                DropShadow: =DropShadow.None
                                                FillPortions: =0
                                                Height: =76
                                                RadiusBottomLeft: =0
                                                RadiusBottomRight: =0
                                                RadiusTopLeft: =0
                                                RadiusTopRight: =0
                                              Children:
                                                - lblAnalysisCsaFieldAvsec:
                                                    Control: Label@2.5.1
                                                    Properties:
                                                      AutoHeight: =true
                                                      Color: =RGBA(2, 16, 59, 1)
                                                      Font: =Font.'Segoe UI'
                                                      FontWeight: =FontWeight.Semibold
                                                      Size: =9
                                                      Text: ="Tratar na CSA"
                                                      Width: =Parent.Width - 24
                                                      X: =12
                                                      Y: =3
                                                - cmbAnalysisCsaAvsec:
                                                    Control: Classic/ComboBox@2.4.0
                                                    Properties:
                                                      BorderColor: =RGBA(229, 229, 229, 1)
                                                      BorderThickness: =1
                                                      ChevronBackground: =RGBA(248, 250, 252, 1)
                                                      ChevronFill: =RGBA(0, 0, 0, 1)
                                                      DefaultSelectedItems: |-
                                                        =If(IsBlank(var_ocorrenciaAvsec.ID), Blank(), Filter(Table({Value: 0, Label: "Não"}, {Value: 1, Label: "Sim"}), Value = Coalesce(var_ocorrenciaAvsec.tratar_csa, 0)))
                                                      DisplayFields: =["Label"]
                                                      Fill: =RGBA(255, 255, 255, 1)
                                                      Font: =Font.'Segoe UI'
                                                      Height: =38
                                                      IsSearchable: =false
                                                      Items: |-
                                                        =Table({Value: 0, Label: "Não"}, {Value: 1, Label: "Sim"})
                                                      PaddingLeft: =8
                                                      SearchFields: =["Label"]
                                                      SelectMultiple: =false
                                                      Size: =10
                                                      Width: =Parent.Width - 24
                                                      X: =12
                                                      Y: =27
                                          - AnalysisJustificationFieldAvsec:
                                              Control: GroupContainer@1.5.0
                                              Variant: ManualLayout
                                              Properties:
                                                DropShadow: =DropShadow.None
                                                FillPortions: =0
                                                Height: =130
                                                RadiusBottomLeft: =0
                                                RadiusBottomRight: =0
                                                RadiusTopLeft: =0
                                                RadiusTopRight: =0
                                                Visible: =cmbAnalysisDsacAvsec.Selected.Value = "nao"
                                              Children:
                                                - lblAnalysisJustificationAvsec:
                                                    Control: Label@2.5.1
                                                    Properties:
                                                      AutoHeight: =true
                                                      Color: =RGBA(2, 16, 59, 1)
                                                      Font: =Font.'Segoe UI'
                                                      FontWeight: =FontWeight.Semibold
                                                      Size: =9
                                                      Text: ="Justificativa para não gerar DSAC *"
                                                      Width: =Parent.Width - 24
                                                      X: =12
                                                      Y: =3
                                                - txtAnalysisJustificationAvsec:
                                                    Control: Classic/TextInput@2.3.2
                                                    Properties:
                                                      BorderColor: =RGBA(229, 229, 229, 1)
                                                      BorderThickness: =1
                                                      Default: =""
                                                      DelayOutput: =true
                                                      Fill: =RGBA(255, 255, 255, 1)
                                                      Font: =Font.'Segoe UI'
                                                      Height: =92
                                                      HintText: ="A justificativa será registrada na timeline."
                                                      HoverBorderColor: =RGBA(0, 0, 0, 1)
                                                      HoverFill: =RGBA(255, 255, 255, 1)
                                                      Mode: =TextMode.MultiLine
                                                      PaddingLeft: =10
                                                      RadiusBottomLeft: =0
                                                      RadiusBottomRight: =0
                                                      RadiusTopLeft: =0
                                                      RadiusTopRight: =0
                                                      Size: =10
                                                      Width: =Parent.Width - 24
                                                      X: =12
                                                      Y: =27
                                          - btnSalvarAnaliseAvsec:
                                              Control: Button@0.0.45
                                              Properties:
                                                Appearance: ='ButtonCanvas.Appearance'.Primary
                                                BorderRadius: =0
                                                DisplayMode: =If(var_processandoAnalise, DisplayMode.Disabled, DisplayMode.Edit)
                                                Font: =Font.'Segoe UI'
                                                FontSize: =12
                                                FontWeight: =FontWeight.Semibold
                                                Icon: ="Save"
                                                Layout: ='ButtonCanvas.Layout'.IconBefore
                                                OnSelect: |-
                                                  =If(
                                                      IsBlank(cmbAnalysisStatusAvsec.Selected.Value) Or
                                                      IsBlank(cmbAnalysisDsacAvsec.Selected.Value) Or
                                                      IsBlank(cmbAnalysisCsaAvsec.Selected.Value),
                                                      Notify("Informe status, classificação DSAC e tratamento na CSA.", NotificationType.Warning, 3500),
                                                      cmbAnalysisDsacAvsec.Selected.Value = "nao" And var_ocorrenciaAvsec.gera_dsac <> "nao" And Len(Trim(txtAnalysisJustificationAvsec.Text)) < 5,
                                                      Notify("Registre a justificativa para a classificação sem DSAC.", NotificationType.Warning, 3500),
                                                      UpdateContext({var_processandoAnalise: true});
                                                      IfError(
                                                          With(
                                                              {
                                                                  _dsacAnterior: var_ocorrenciaAvsec.gera_dsac,
                                                                  _ocorrenciaAtualizada: Patch(
                                                                      tb_avsecOcorrencias,
                                                                      var_ocorrenciaAvsec,
                                                                      {
                                                                          status: cmbAnalysisStatusAvsec.Selected.Value,
                                                                          gera_dsac: cmbAnalysisDsacAvsec.Selected.Value,
                                                                          tratar_csa: cmbAnalysisCsaAvsec.Selected.Value
                                                                      }
                                                                  )
                                                              },
                                                              If(
                                                                  cmbAnalysisDsacAvsec.Selected.Value = "nao" And
                                                                  (_dsacAnterior <> "nao" Or !IsBlank(Trim(txtAnalysisJustificationAvsec.Text))),
                                                                  Patch(
                                                                      tb_avsecDesdobramentos,
                                                                      Defaults(tb_avsecDesdobramentos),
                                                                      {
                                                                          id_fk_ocorrencia: _ocorrenciaAtualizada.ID,
                                                                          aeroporto: _ocorrenciaAtualizada.aeroporto,
                                                                          categoria: "classificacao_dsac",
                                                                          conteudo: Trim(txtAnalysisJustificationAvsec.Text),
                                                                          ativo: true
                                                                      }
                                                                  )
                                                              );
                                                              Set(var_ocorrenciaAvsec, _ocorrenciaAtualizada);
                                                              Set(var_dados_avsec, _ocorrenciaAtualizada)
                                                          );
                                                          UpdateContext({var_processandoAnalise: false});
                                                          Reset(txtAnalysisJustificationAvsec);
                                                          Refresh(tb_avsecOcorrencias);
                                                          Refresh(tb_avsecDesdobramentos);
                                                          Notify("Análise AVSEC atualizada.", NotificationType.Success, 3000),
                                                          UpdateContext({var_processandoAnalise: false});
                                                          Notify("Não foi possível atualizar a análise AVSEC.", NotificationType.Error, 5000)
                                                      )
                                                  )
                                                Text: ="Salvar análise"
                                                Width: =Parent.Width
                                          - DeadlineCardAvsec:
                                              Control: GroupContainer@1.5.0
                                              Variant: AutoLayout
                                              Properties:
                                                BorderColor: =RGBA(229, 229, 229, 1)
                                                BorderThickness: =1
                                                DropShadow: =DropShadow.None
                                                Fill: =RGBA(255, 255, 255, 1)
                                                FillPortions: =0
                                                Height: =104
                                                LayoutDirection: =LayoutDirection.Vertical
                                                LayoutGap: =5
                                                PaddingBottom: =8
                                                PaddingLeft: =8
                                                PaddingRight: =8
                                                PaddingTop: =8
                                                RadiusBottomLeft: =0
                                                RadiusBottomRight: =0
                                                RadiusTopLeft: =0
                                                RadiusTopRight: =0
                                              Children:
                                                - lblDeadlineTitleAvsec:
                                                    Control: Label@2.5.1
                                                    Properties:
                                                      AutoHeight: =true
                                                      Color: =RGBA(148, 163, 184, 1)
                                                      Font: =Font.'Segoe UI'
                                                      FontWeight: =FontWeight.Semibold
                                                      Size: =8
                                                      Text: ="PRAZO REGULATÓRIO — 30 DIAS"
                                                - lblDeadlineDateAvsec:
                                                    Control: Label@2.5.1
                                                    Properties:
                                                      AutoHeight: =true
                                                      Color: =RGBA(2, 16, 59, 1)
                                                      Font: =Font.'Segoe UI'
                                                      FontWeight: =FontWeight.Semibold
                                                      Size: =10
                                                      Text: |-
                                                        ="Limite: " & Text(var_ocorrenciaAvsec.data_limite_dsac, "dd/mm/yyyy")
                                                - lblDeadlineStateAvsec:
                                                    Control: Label@2.5.1
                                                    Properties:
                                                      Align: =Align.Center
                                                      Color: |-
                                                        =With({dias: DateDiff(Today(), DateValue(var_ocorrenciaAvsec.data_limite_dsac), TimeUnit.Days)}, If(dias < 0, RGBA(185, 28, 28, 1), If(dias <= 5, RGBA(180, 83, 9, 1), RGBA(22, 101, 52, 1))))
                                                      Fill: |-
                                                        =With({dias: DateDiff(Today(), DateValue(var_ocorrenciaAvsec.data_limite_dsac), TimeUnit.Days)}, If(dias < 0, RGBA(254, 226, 226, 1), If(dias <= 5, RGBA(254, 243, 199, 1), RGBA(220, 252, 231, 1))))
                                                      Font: =Font.'Segoe UI'
                                                      FontWeight: =FontWeight.Bold
                                                      Height: =34
                                                      Size: =9
                                                      Text: |-
                                                        =With({dias: DateDiff(Today(), DateValue(var_ocorrenciaAvsec.data_limite_dsac), TimeUnit.Days)}, If(var_ocorrenciaAvsec.status = "encerrada" Or var_ocorrenciaAvsec.status = "enviada_anac" Or var_ocorrenciaAvsec.status = "arquivada_sem_dsac", "Ciclo concluído", If(dias < 0, "Vencido há " & Abs(dias) & " dia(s)", dias & " dia(s) restante(s)")))
                                                      Width: =Parent.Width
                                          - DetailsAttachmentsCardAvsec:
                                              Control: GroupContainer@1.5.0
                                              Variant: AutoLayout
                                              Properties:
                                                DropShadow: =DropShadow.None
                                                FillPortions: =0
                                                Height: =155
                                                LayoutDirection: =LayoutDirection.Vertical
                                                LayoutGap: =5
                                                PaddingTop: =5
                                                RadiusBottomLeft: =0
                                                RadiusBottomRight: =0
                                                RadiusTopLeft: =0
                                                RadiusTopRight: =0
                                              Children:
                                                - lblDetailsAttachmentsTitleAvsec:
                                                    Control: Label@2.5.1
                                                    Properties:
                                                      AutoHeight: =true
                                                      Color: =RGBA(148, 163, 184, 1)
                                                      Font: =Font.'Segoe UI'
                                                      FontWeight: =FontWeight.Semibold
                                                      Size: =8
                                                      Text: ="ANEXOS DA OCORRÊNCIA"
                                                - attDetailsOcorrenciaAvsec:
                                                    Control: Attachments@2.3.0
                                                    Properties:
                                                      BorderColor: =RGBA(229, 229, 229, 1)
                                                      DisplayMode: =DisplayMode.View
                                                      Font: =Font.'Segoe UI'
                                                      Height: =120
                                                      Items: =var_ocorrenciaAvsec.Anexos
                                                      Items.Name: =DisplayName
                                                      Items.Value: =Id
                                                      PaddingBottom: =5
                                                      PaddingLeft: =5
                                                      PaddingRight: =5
                                                      PaddingTop: =5
                                                      Size: =9
                                                      Width: =Parent.Width
            - LoadingOverlayAvsec:
                Control: GroupContainer@1.5.0
                Variant: ManualLayout
                Properties:
                  DropShadow: =DropShadow.None
                  Fill: =RGBA(15, 23, 42, 0.55)
                  Height: =Parent.Height
                  RadiusBottomLeft: =0
                  RadiusBottomRight: =0
                  RadiusTopLeft: =0
                  RadiusTopRight: =0
                  Visible: =var_visibleProcessando
                  Width: =Parent.Width
                Children:
                  - lblLoadingOverlayAvsec:
                      Control: Label@2.5.1
                      Properties:
                        Align: =Align.Center
                        AutoHeight: =true
                        Color: =RGBA(255, 255, 255, 1)
                        Font: =Font.'Segoe UI'
                        FontWeight: =FontWeight.Bold
                        Height: =60
                        Size: =14
                        Text: ="Processando..."
                        Width: =260
                        X: =Parent.Width / 2 - Self.Width / 2
                        Y: =Parent.Height / 2 - Self.Height / 2
