                              RadiusTopRight: =0
                              Visible: =Coalesce(var_visible, "Novo Registro") = "Detalhes"
                              Width: =Min(980, Parent.Width - If(App.Width < 900, 24, 100))
                            Children:
                              - DetailsHeaderAvsec:
                                  Control: GroupContainer@1.5.0
                                  Variant: AutoLayout
                                  Properties:
                                    BorderColor: =RGBA(229, 229, 229, 1)
