                                                        =Table({Value: "pendente", Label: "Pendente"}, {Value: "sim", Label: "Sim"}, {Value: "nao", Label: "Não"})
                                                      NoSelectionText: ="Todos"
                                                      PaddingLeft: =8
                                                      SearchFields: =["Label"]
                                                      SelectMultiple: =false
                                                      Size: =10
                                                      Width: =Parent.Width - 24
                                                      X: =12
                                                      Y: =27
                                          - btnLimparFiltrosAvsec:
                                              Control: Button@0.0.45
                                              Properties:
                                                AlignInContainer: =AlignInContainer.End
                                                Appearance: ='ButtonCanvas.Appearance'.Secondary
                                                BorderRadius: =0
                                                Font: =Font.'Segoe UI'
                                                FontSize: =12
                                                FontWeight: =FontWeight.Semibold
                                                Height: =36
                                                Icon: ="DismissCircle"
                                                OnSelect: |-
                                                  =Reset(txtBuscaAvsec);
                                                  Reset(cmbFiltroAeroportoAvsec);
                                                  Reset(cmbFiltroStatusAvsec);
                                                  Reset(cmbFiltroDsacAvsec)
                                                Text: ="Limpar"
                                                Width: =105
                                    - galOcorrenciasAvsec:
                                        Control: Gallery@2.15.0
                                        Variant: Vertical
                                        Properties:
                                          BorderColor: =RGBA(229, 229, 229, 1)
                                          Fill: =RGBA(255, 255, 255, 1)
                                          Height: =560
                                          Items: |-
                                            =SortByColumns(
                                                Filter(
                                                    tb_avsecOcorrencias,
                                                    modulo = "acesso_indevido_pessoas" And
                                                    Coalesce(ativo, 1) = 1 And
                                                    (
                                                        IsBlank(Trim(txtBuscaAvsec.Text)) Or
                                                        StartsWith(local, Trim(txtBuscaAvsec.Text)) Or
                                                        StartsWith(aeroporto, Trim(txtBuscaAvsec.Text))
                                                    ) And
                                                    (
                                                        IsBlank(cmbFiltroAeroportoAvsec.Selected.Aeroporto) Or
                                                        aeroporto = cmbFiltroAeroportoAvsec.Selected.Aeroporto
                                                    ) And
                                                    (
                                                        IsBlank(cmbFiltroStatusAvsec.Selected.Value) Or
                                                        status = cmbFiltroStatusAvsec.Selected.Value
                                                    ) And
                                                    (
                                                        IsBlank(cmbFiltroDsacAvsec.Selected.Value) Or
                                                        gera_dsac = cmbFiltroDsacAvsec.Selected.Value
                                                    )
                                                ),
                                                "inicio",
                                                SortOrder.Descending
                                            )
                                          TemplateFill: =RGBA(255, 255, 255, 1)
                                          TemplatePadding: =8
                                          TemplateSize: =118
                                          Width: =Parent.Width
                                        Children:
                                          - rectRegistroAvsec:
                                              Control: Rectangle@2.3.0
                                              Properties:
                                                Fill: =If(ThisItem.IsSelected, RGBA(0, 0, 0, 1), RGBA(229, 229, 229, 1))
                                                Height: =Parent.TemplateHeight - 8
                                                Width: =1
                                                Y: =4
                                          - lblRegistroIdAvsec:
                                              Control: Label@2.5.1
                                              Properties:
                                                AutoHeight: =true
                                                Color: =RGBA(0, 0, 0, 1)
                                                Font: =Font.'Segoe UI'
                                                FontWeight: =FontWeight.Bold
                                                Size: =11
                                                Text: ="#" & Text(ThisItem.ID, "00000")
                                                Width: =90
                                                Y: =13
                                          - lblRegistroTipoAvsec:
                                              Control: Label@2.5.1
                                              Properties:
                                                AutoHeight: =true
                                                Color: =RGBA(2, 16, 59, 1)
                                                Font: =Font.'Segoe UI'
                                                FontWeight: =FontWeight.Bold
                                                Size: =11
                                                Text: =Switch(ThisItem.tipo_acesso, "acesso_indevido", "Acesso indevido", "tentativa_acesso_indevido", "Tentativa de acesso indevido", Coalesce(ThisItem.tipo_acesso, "Não informado"))
                                                Width: =Min(300, Parent.TemplateWidth * 0.28)
                                                X: =1
                                                Y: =12
                                          - lblRegistroLocalAvsec:
                                              Control: Label@2.5.1
                                              Properties:
                                                AutoHeight: =true
                                                Color: =RGBA(0, 0, 0, 0.7)
                                                Font: =Font.'Segoe UI'
                                                Size: =10
                                                Text: =ThisItem.aeroporto & " • " & ThisItem.local
                                                Width: =Parent.TemplateWidth - 540
                                                X: =1
                                                Y: =43
                                          - lblRegistroDataAvsec:
                                              Control: Label@2.5.1
                                              Properties:
                                                AutoHeight: =true
                                                Color: =RGBA(0, 0, 0, 0.7)
                                                Font: =Font.'Segoe UI'
                                                Size: =10
                                                Text: =Text(ThisItem.inicio, "dd/mm/yyyy HH:mm")
                                                Width: =1
                                                Y: =16
                                          - lblRegistroStatusAvsec:
                                              Control: Label@2.5.1
                                              Properties:
                                                Align: =Align.Center
                                                Color: =Switch(ThisItem.status, "encerrada", RGBA(22, 101, 52, 1), "arquivada_sem_dsac", RGBA(22, 101, 52, 1), "escalonada_ao_bloco", RGBA(185, 28, 28, 1), "enviada_anac", RGBA(22, 101, 52, 1), RGBA(0, 0, 0, 1))
                                                Fill: =Switch(ThisItem.status, "encerrada", RGBA(220, 252, 231, 1), "arquivada_sem_dsac", RGBA(220, 252, 231, 1), "escalonada_ao_bloco", RGBA(254, 226, 226, 1), "enviada_anac", RGBA(220, 252, 231, 1), RGBA(248, 250, 252, 1))
                                                Font: =Font.'Segoe UI'
                                                FontWeight: =FontWeight.Semibold
                                                Height: =28
                                                Size: =9
                                                Text: =Switch(ThisItem.status, "aguardando_analise_avsec", "Aguardando análise AVSEC", "em_analise_avsec", "Em análise AVSEC", "arquivada_sem_dsac", "Arquivada sem DSAC", "encaminhada_ao_bloco", "Encaminhada ao bloco", "escalonada_ao_bloco", "Escalonada ao bloco", "em_elaboracao_dsac", "Em elaboração DSAC", "enviada_anac", "Enviada à ANAC", "encerrada", "Encerrada", Coalesce(ThisItem.status, "Não definido"))
                                                Width: =170
                                                Y: =12
                                          - lblRegistroPrazoAvsec:
                                              Control: Label@2.5.1
                                              Properties:
                                                AutoHeight: =true
                                                Color: |-
                                                  =With({dias: DateDiff(Today(), DateValue(ThisItem.data_limite_dsac), TimeUnit.Days)}, If(dias < 0, RGBA(185, 28, 28, 1), If(dias <= 5, RGBA(180, 83, 9, 1), RGBA(71, 85, 105, 1))))
                                                Font: =Font.'Segoe UI'
                                                Size: =9
                                                Text: |-
                                                  =With({dias: DateDiff(Today(), DateValue(ThisItem.data_limite_dsac), TimeUnit.Days)}, If(ThisItem.status = "encerrada" Or ThisItem.status = "enviada_anac" Or ThisItem.status = "arquivada_sem_dsac", "Ciclo concluído", If(dias < 0, "Vencido há " & Abs(dias) & " dia(s)", dias & " dia(s) restante(s)")))
                                                Width: =170
                                                Y: =50
                                          - btnAbrirRegistroAvsec:
                                              Control: Button@0.0.45
                                              Properties:
                                                Appearance: ='ButtonCanvas.Appearance'.Secondary
                                                BorderRadius: =0
                                                Font: =Font.'Segoe UI'
                                                FontSize: =12
                                                FontWeight: =FontWeight.Semibold
                                                Height: =34
                                                Icon: ="Open"
                                                OnSelect: |-
                                                  =Set(var_ocorrenciaAvsec, ThisItem);
                                                  Set(var_dados_avsec, ThisItem);
                                                  UpdateContext(
                                                      {
                                                          var_visible: "Detalhes",
                                                          var_acao: "view",
                                                          var_visibleDesdobramento: false
                                                      }
                                                  );
                                                  Refresh(tb_avsecDesdobramentos)
                                                Text: ="Abrir"
                                                Width: =90
                                                Y: =39
                                    - lblRecordsEmptyAvsec:
                                        Control: Label@2.5.1
                                        Properties:
                                          Align: =Align.Center
                                          AutoHeight: =true
                                          Color: =RGBA(148, 163, 184, 1)
                                          Font: =Font.'Segoe UI'
                                          Size: =11
                                          Text: ="Nenhum registro encontrado para os filtros informados."
                                          Visible: =CountRows(galOcorrenciasAvsec.AllItems) = 0
                                          Width: =Parent.Width
                        - DetalhesViewAvsec:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
