                                                      Font: =Font.'Segoe UI'
                                                      Size: =8
                                                      Text: |-
                                                        ="Por: " & Coalesce(var_ocorrenciaAvsec.'Criado por'.DisplayName, "Não informado")
                                                      Width: =Parent.Width
                                          - galDesdobramentosAvsec:
                                              Control: Gallery@2.15.0
                                              Variant: Vertical
                                              Properties:
                                                BorderColor: =RGBA(229, 229, 229, 1)
                                                Height: =430
                                                Items: =SortByColumns(Filter(tb_avsecDesdobramentos, id_fk_ocorrencia = var_ocorrenciaAvsec.ID And (ativo = true Or IsBlank(ativo))), "Created", SortOrder.Ascending)
                                                TemplateFill: =RGBA(255, 255, 255, 1)
                                                TemplatePadding: =8
                                                TemplateSize: =150
                                                Width: =Parent.Width
                                              Children:
                                                - rectTimelineAvsec:
                                                    Control: Rectangle@2.3.0
                                                    Properties:
                                                      Fill: =RGBA(0, 0, 0, 1)
                                                      Height: =Parent.TemplateHeight - 12
                                                      Width: =3
                                                      Y: =6
                                                - lblTimelineCategoryAvsec:
                                                    Control: Label@2.5.1
                                                    Properties:
                                                      AutoHeight: =true
                                                      Color: =RGBA(0, 0, 0, 1)
                                                      Font: =Font.'Segoe UI'
                                                      FontWeight: =FontWeight.Bold
                                                      Size: =9
                                                      Text: =Upper(Switch(ThisItem.categoria, "acao_corretiva", "Ação corretiva", "acao_preventiva", "Ação preventiva", "analise_avsec", "Análise AVSEC", "classificacao_dsac", "Classificação DSAC", "tratativa_bloco", "Tratativa do bloco", "evidencia_comprovacao", "Evidência / comprovação", "encerramento", "Encerramento", "outro", "Outro", Coalesce(ThisItem.categoria, "Outro")))
                                                      Width: =Parent.TemplateWidth - 190
                                                      X: =16
                                                      Y: =12
                                                - lblTimelineDateAvsec:
                                                    Control: Label@2.5.1
