                                                          Variant: ClassicTextualEdit
                                                          Properties:
                                                            BorderColor: =RGBA(0, 0, 0, 0)
                                                            DataField: ="aeroporto"
                                                            Default: =ThisItem.aeroporto
                                                            DisplayName: ="aeroporto"
                                                            Fill: =RGBA(255, 255, 255, 1)
                                                            MaxLength: =DataSourceInfo([@tb_avsecDesdobramentos], DataSourceInfo.MaxLength, aeroporto)
                                                            Required: =true
                                                            Update: =var_ocorrenciaAvsec.aeroporto
                                                            Visible: =false
                                                            Width: =Parent.Width
                                                            X: =0
                                                            Y: =1
                                                      - categoria_DataCardAvsec:
