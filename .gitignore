# ---------------------------------------------------------------
# PowerApps---YAML — Motiva / AirportNow
# Binários de projeto (.zip, .msapp, .docx, .xlsx, .pdf, imagens)
# são versionados de propósito: fazem parte da entrega.
# Aqui fica só o que é gerado, temporário ou pessoal.
# ---------------------------------------------------------------

# Python gerado
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# Node
node_modules/
npm-debug.log*

# Cópias locais criadas antes de um pull
#   mv SAFETY SAFETY.local
*.local/
*.bak
*.orig
*.rej

# Sistema operacional
.DS_Store
._*
Thumbs.db
desktop.ini

# Arquivos de bloqueio do Office (abrem junto com .docx/.xlsx)
~$*

# Configuração pessoal do Claude Code — as skills do time continuam versionadas
.claude/settings.local.json
