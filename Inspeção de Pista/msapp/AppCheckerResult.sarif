erMenuItem_6.Label1_55","member":"Visible"}}],"properties":{"level":"Medium"}},{"ruleId":"app-CountRowsGalleryAllItems","ruleIndex":10,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"frmInspPistaMob.ContainerVincularDataBase.Container8_3.Container32_1.ButtonCanvasSalvarTodos.OnSelect"}},"logicalLocations":[{"fullyQualifiedName":"frmInspPistaMob.ContainerVincularDataBase.Container8_3.Container32_1.ButtonCanvasSalvarTodos.OnSelect"}],"properties":{"module":"frmInspPistaMob","type":"frmInspPistaMob.ContainerVincularDataBase.Container8_3.Container32_1.ButtonCanvasSalvarTodos","member":"OnSelect"}}],"properties":{"level":"Medium"}},{"ruleId":"app-ForAllWithMutation","ruleIndex":11,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"frmInspPistaMob.ContainerVincularDataBase.Container8_3.Container32_1.ButtonCanvasSalvarTodos.OnSelect"}},"logicalLocations":[{"fullyQualifiedName":"frmInspPistaMob.ContainerVincularDataBase.Container8_3.Container32_1.ButtonCanvasSalvarTodos.OnSelect"}],"properties":{"module":"frmInspPistaMob","type":"frmInspPistaMob.ContainerVincularDataBase.Container8_3.Container32_1.ButtonCanvasSalvarTodos","member":"OnSelect"}}],"properties":{"level":"Medium"}},{"ruleId":"app-UnusedVariables","ruleIndex":6,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"ScreenLogin.var_visibleSpinLoader"}},"logicalLocations":[{"fullyQualifiedName":"ScreenLogin.var_visibleSpinLoader"}],"properties":{"module":"ScreenLogin","type":"ScreenLogin","member":"var_visibleSpinLoader"}}],"properties":{"level":"Medium"}}],"tool":{"driver":{"name":"PowerApps app checker","fullName":"PowerApps app checker","version":"1.349","rules":[{"id":"app-SuggestRemoteExecutionHint","messageStrings":{"issue":{"text":"Delegation warning. The \"{0}\" part of this formula might not work correctly on large data sets."}},"properties":{"howToFix":["If your data set exceeds the 500 record limit but contains less than 2,000 records, try resetting the limit.","Try simplifying the formula.","Try moving your data to a different data source."],"whyFix":"","level":"Medium","componentType":"app","primaryCategory":"formula"}},{"id":"app-SuggestRemoteExecutionHint-OpNotSupportedByService","messageStrings":{"issue":{"text":"Delegation warning. The highlighted part of this formula might not work correctly on large data sets. The \"{0}\" operation is not supported by this connector."}},"properties":{"howToFix":["If your data set exceeds the 500 record limit but contains less than 2,000 records, try resetting the limit.","Try simplifying the formula.","Try moving your data to a different data source."],"whyFix":"","level":"Medium","componentType":"app","primaryCategory":"formula"}},{"id":"app-SuggestRemoteExecutionHint-OpNotSupportedByColumn","messageStrings":{"issue":{"text":"Delegation warning. The highlighted part of this formula might not work correctly with column \"{0}\" on large data sets."}},"properties":{"howToFix":["If your data set exceeds the 500 record limit but contains less than 2,000 records, try resetting the limit.","Try simplifying the formula.","Try moving your data to a different data source."],"whyFix":"","level":"Medium","componentType":"app","primaryCategory":"formula"}},{"id":"acc-AccessibleLabelNeeded","messageStrings":{"issue":{"text":"Missing accessible label"}},"properties":{"howToFix":["Edit the accessible label property to describe the item."],"whyFix":"If there's no accessible text, people who can’t see the screen won't understand what’s in images and controls.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"acc-TabIndexShouldBeDefinedForInteractiveControl","messageStrings":{"issue":{"text":"Missing tab stop"}},"properties":{"howToFix":["Set TabIndex to 0 or greater to ensure that interactive elements have a tab stop."],"whyFix":"People who use the keyboard with your app will not be able to access this element without a tab stop.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"acc-FocusBorderShouldBeVisible","messageStrings":{"issue":{"text":"Focus isn't showing"}},"properties":{"howToFix":["Change the FocusedBorderThickness property to be more than 0."],"whyFix":"If the focus isn't visible, people who don't use a mouse won't be able to see it when they're interacting with the app.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"app-UnusedVariables","messageStrings":{"issue":{"text":"Variável não usada"}},"properties":{"howToFix":["Remover a variável não usada."],"whyFix":"Essa variável está declarada, mas não é referenciada por nenhum controle, portanto não é necessária.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-UnusedMediaResources","messageStrings":{"issue":{"text":"Arquivos de mídia não utilizados"}},"properties":{"howToFix":["Remova o arquivo de mídia não utilizado no painel Mídia."],"whyFix":"Este arquivo de mídia não é referenciado por nenhuma fórmula de controle, portanto não é necessário. Sua remoção melhorará o desempenho.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-CollectingReadOnlyTable","messageStrings":{"issue":{"text":"A coleção foi inicializada, mas nunca atualizada"}},"properties":{"howToFix":["Substitua Collect ou ClearCollect por uma fórmula nomeada no App.Formulas. Por exemplo, MyTable = Filter(source, condition). Fórmulas nomeadas são calculadas quando suas entradas mudam e não têm o custo de acompanhamento de uma coleção."],"whyFix":"Coleções são feitas para serem atualizadas. O Power Apps faz um trabalho adicional para acompanhar cada coleção, garantindo que tudo que dependa dela fique sincronizado quando os dados mudam. Quando os dados não mudam depois de configurados, esse trabalho de acompanhamento é desperdiçado. Uma fórmula nomeada fornece os mesmos dados sem esse custo adicional.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-ScreenHasManyControls","messageStrings":{"issue":{"text":"Muitos controles em uma tela"}},"properties":{"howToFix":["Reduza o número de controles na tela.","Divida o aplicativo em mais telas para reduzir a complexidade por tela.","Use componentes para unificar os controles agrupados que são idênticos entre telas, reduzindo a duplicação.","Use galerias para representar uma série de controles semelhantes repetidos.","Divida o aplicativo em vários aplicativos para que cada aplicativo seja pequeno e tenha maior desempenho."],"whyFix":"Cada controle consome recursos e, quando uma tela tem muitos controles, o aplicativo pode ficar lento ou parar de responder. A complexidade estimada de \"frmInspPistaMob\" é 419, o que excede o limite máximo recomendado (300).","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-CountRowsGalleryAllItems","messageStrings":{"issue":{"text":"Use AllItemsCount em vez de CountRows com AllItems"}},"properties":{"howToFix":["Substitua CountRows(Gallery.AllItems) por Gallery.AllItemsCount para melhor desempenho."],"whyFix":"Usar CountRows com a propriedade AllItems de uma galeria força a criação de uma tabela de saída que contém uma cópia da fonte de dados de entrada e o estado atual de todos os controles filhos. Isso pode forçar a inicialização de linhas não inicializadas, consumindo ciclos extras de CPU, memória e potencialmente gerando solicitações de rede por linha.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-ForAllWithMutation","messageStrings":{"issue":{"text":"Modificar uma coleção ou fonte de dados dentro do ForAll pode causar uma reavaliação excessiva das regras"}},"properties":{"howToFix":["Como o ForAll retorna uma tabela, passe seu resultado como entrada para a função de mutação em uma única chamada em lote. Por exemplo, substitua ForAll(source, Collect(c, { ... })) por Collect(c, ForAll(source, { ... })); o mesmo padrão vale para Patch e Remove. Uma única mutação em lote emite uma notificação de mudança em vez de uma por iteração.","Para atualizações ou exclusões triviais por linha em uma fonte de dados, prefira as funções delegáveis UpdateIf ou RemoveIf chamadas uma vez fora do ForAll, em vez de iterar com ForAll."],"whyFix":"Usar Collect, Patch, Remove ou outra função de mutação dentro do corpo do ForAll altera a fonte de dados ou a coleção alvo uma vez por iteração. Cada propriedade de controle que depende dessa coleção ou fonte de dados é reavaliada a cada mutação, o que pode transformar um pequeno loop em milhares de avaliações de regras e, para fontes de dados conectadas, em uma solicitação de rede por linha.","componentType":"app","primaryCategory":"performance","level":"Medium"}}]}},"invocations":[{"executionSuccessful":true}],"columnKind":"utf16CodeUnits"}]}