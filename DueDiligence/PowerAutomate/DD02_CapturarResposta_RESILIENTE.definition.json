          "runAfter": {
            "HTTP_Consultar_Inbox": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": {
            "and": [
              {
                "equals": [
                  "@equals(length(body('HTTP_Consultar_Inbox')?['value']), 0)",
                  true
                ]
              }
            ]
          },
          "actions": {
            "Montar_Entrada": {
              "runAfter": {},
              "type": "Compose",
              "inputs": {
                "forms_chave": "@string(outputs('Montar_Chave_Resposta'))",
                "forms_formulario_id": "itUz0nOZp0OvaWdjYwVIoMoEbKAMYIZFqUAdth6B_EFURVRKSFdaVDE4Q1RIV0VTRkxFSjFZS0VEQS4u",
                "forms_resposta_id": "@string(triggerOutputs()?['body/resourceData/responseId'])",
                "codigo_acompanhamento": "@trim(string(body('Obter_detalhes_da_resposta')?['rf6e81f83fe194d4c80dbfd30fc7b8301']))",
                "conteudo_json": "@string(body('Obter_detalhes_da_resposta'))",
                "capturado_em": "@utcNow()",
                "estado": "Pendente",
                "tentativas": 0
              }
            },
            "HTTP_Criar_Entrada": {
              "runAfter": {
                "Montar_Entrada": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "https://grupoccr.sharepoint.com/sites/ComplianceAeroportos",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/lists/getbytitle('tb_dueDiligenceRespostasInbox')/items",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata",
                    "Content-Type": "application/json;odata=nometadata"
                  },
                  "parameters/body": "@string(outputs('Montar_Entrada'))"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest"
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "none"
                }
              }
            },
            "HTTP_Conferir_Inbox_Apos_Falha": {
              "runAfter": {
                "HTTP_Criar_Entrada": [
                  "Failed",
                  "TimedOut"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "https://grupoccr.sharepoint.com/sites/ComplianceAeroportos",
                  "parameters/method": "GET",
                  "parameters/uri": "@concat('_api/web/lists/getbytitle(''tb_dueDiligenceRespostasInbox'')/items?$select=ID,forms_chave&$filter=forms_chave eq ''', replace(outputs('Montar_Chave_Resposta'), '''', ''''''), '''')",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest"
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "none"
                }
              }
            },
            "Condicao_Entrada_Existe_Apos_Falha": {
              "runAfter": {
                "HTTP_Conferir_Inbox_Apos_Falha": [
                  "Succeeded"
                ]
              },
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@equals(length(body('HTTP_Conferir_Inbox_Apos_Falha')?['value']), 1)",
                      true
                    ]
                  }
                ]
              },
              "actions": {
                "Entrada_Ja_Capturada": {
                  "runAfter": {},
                  "type": "Compose",
                  "inputs": "Response ID já consta na Inbox."
                }
              },
              "else": {
                "actions": {
                  "Falha_Captura": {
                    "runAfter": {},
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Failed",
                      "runError": {
                        "code": "DD02_CAPTURA_FALHOU",
                        "message": "Resposta não confirmada na Inbox."
                      }
                    }
                  }
                }
              }
            }
          },
          "else": {
            "actions": {
              "Condicao_Registro_Existente": {
                "runAfter": {},
                "type": "If",
                "expression": {
                  "and": [
                    {
                      "equals": [
                        "@equals(length(body('HTTP_Consultar_Inbox')?['value']), 1)",
                        true
