          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://grupoccr.sharepoint.com/sites/ComplianceAeroportos",
              "parameters/method": "GET",
              "parameters/uri": "@concat('_api/web/lists/getbytitle(''tb_dueDiligenceRespostasInbox'')/items?$select=ID,forms_chave&$filter=forms_chave eq ''', replace(outputs('Montar_Chave_Resposta'), '''', ''''''), '''')",
