              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "poster": "Flow bot",
                  "location": "Group chat",
                  "body/recipient": "@outputs('Criar_um_chat')?['body/id']",
                  "body/messageBody": "{\n  \"$schema\": \"https://adaptivecards.io/schemas/adaptive-card.json\",\n  \"type\": \"AdaptiveCard\",\n  \"version\": \"1.4\",\n  \"body\": [\n    {\n      \"type\": \"Container\",\n      \"items\": [\n        {\n          \"type\": \"TextBlock\",\n          \"text\": \"Acionamento PLEM/PRAI\",\n          \"weight\": \"Bolder\",\n          \"size\": \"Large\",\n          \"wrap\": true\n        },\n        {\n          \"type\": \"TextBlock\",\n          \"text\": \"Emergência: @{triggerBody()?['text_1']}\",\n          \"wrap\": true\n        },\n {\n          \"type\": \"TextBlock\",\n          \"text\": \"Informamos que a emergência foi registrada no aeroporto. Se você tiver disponibilidade, por favor, dirija-se ao COE para auxiliar no gerenciamento da crise. Para mais informações, utilize este chat para interação. Evite contato com a equipe operacional por outros canais, a fim de não comprometer a gestão da ocorrência.\",\n          \"wrap\": true\n        }\n      ]\n    }\n  ]\n}\n"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                  "connectionName": "shared_teams",
                  "operationId": "PostCardToConversation"
                },
                "authentication": {
