                                    \"text\": \"Orientações: \",\n                                    \"wrap\": true\n                                },\n  {\n                                    \"type\": \"TextBlock\",\n                                    \"text\": \"@{triggerBody()?['text_8']}\",\n                                    \"wrap\": true\n                                },\n {\n                                    \"type\": \"TextBlock\",\n                                    \"text\": \"@{triggerBody()?['text_6']}\",\n                                    \"wrap\": true\n                                }, {\n                                    \"type\": \"TextBlock\",\n                                    \"text\": \"@{triggerBody()?['text_9']}\",\n                                    \"wrap\": true\n                                }, {\n                                    \"type\": \"TextBlock\",\n                                    \"text\": \"@{triggerBody()?['text_10']}\",\n                                    \"wrap\": true\n                                }, {\n                                    \"type\": \"TextBlock\",\n                                    \"text\": \"@{triggerBody()?['text_11']}\",\n                                    \"wrap\": true\n                                },\n {\n                                    \"type\": \"TextBlock\",\n                                    \"text\": \"@{triggerBody()?['text_12']}\",\n                                    \"wrap\": true\n                                }\n          ]\n        }\n      ]\n    }\n  ],\n  \"actions\": [\n    {\n      \"type\": \"Action.OpenUrl\",\n      \"title\": \"INMET\",\n      \"url\": \"https://alertas2.inmet.gov.br\"\n    }\n  ],\n  \"$schema\": \"http://adaptivecards.io/schemas/adaptive-card.json\",\n  \"version\": \"1.4\"\n}",
