              "item/ID_chat": "@triggerBody()?['text_6']",
              "item/Acao": "RESPONDEU AO FLOW",
              "item/Atividade": "@{triggerBody()?['text_2']} > Respondeu ao Flow > \n@{outputs('Postar_uma_escolha_de_opções')?['body/comments']} ",
              "item/Hora": "@formatDateTime(convertFromUtc(outputs('Postar_uma_escolha_de_opções')?['body/responseTime'], 'E. South America Standard Time'), 'dd/MM/yyyy HH:mm:ss')",
              "item/Excluido": 0,
              "item/Ativo": 0
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "PostItem"
            },
            "authentication": {
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
              "type": "Raw"
            }
          }
        },
