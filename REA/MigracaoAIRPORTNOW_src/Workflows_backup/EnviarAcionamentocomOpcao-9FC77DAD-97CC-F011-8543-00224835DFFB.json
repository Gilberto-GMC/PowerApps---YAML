      "actions": {
        "Enviar_um_email_(V2)": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "25886673-4861-4574-ab4c-e9a2363ba4ac"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2"
            },
            "parameters": {
              "emailMessage/To": "@triggerBody()?['text']",
              "emailMessage/Subject": "Airport Now - Acionamento PLEM - @{triggerBody()?['text_3']}",
              "emailMessage/Body": "<p class=\"editor-paragraph\">Prezados,</p><br><p class=\"editor-paragraph\">Informamos que a emergência @{triggerBody()?['text_1']} foi registrada no aeroporto. Se você tiver disponibilidade, por favor, dirija-se ao COE para auxiliar no gerenciamento da crise. Para mais informações, utilize este chat para interação. Evite contato com a equipe operacional por outros canais, a fim de não comprometer a gestão da ocorrência.</p><br><p class=\"editor-paragraph\">Ocorrência:</p><p class=\"editor-paragraph\">@{triggerBody()?['text_5']}<br><br><br><br><br><br><br></p><br><p class=\"editor-paragraph\"><i><em class=\"editor-text-italic\">Esta mensagem foi gerada automaticamente por - AirPort Now</em></i></p>",
              "emailMessage/Importance": "Normal"
            },
            "authentication": {
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
              "type": "Raw"
            }
          }
        },
        "Postar_uma_escolha_de_opções": {
          "runAfter": {
            "Responder_ao_app": [
              "Succeeded"
            ]
          },
          "limit": {
            "timeout": "PT4H"
          },
          "metadata": {
            "operationMetadataId": "cfc9222a-3cc9-483a-b808-2e798aa48770"
          },
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "parameters": {
              "UserMessageWithOptionsSubscriptionRequest/body/options": [
                "Ciente"
              ],
              "UserMessageWithOptionsSubscriptionRequest/body/recipient/to": "@triggerBody()?['text']",
              "UserMessageWithOptionsSubscriptionRequest/body/messageBody": "Alerta de acionamento \n\nInformamos que a emergência @{triggerBody()?['text_1']} foi registrada no aeroporto. Se você tiver disponibilidade, por favor, dirija-se ao COE para auxiliar no gerenciamento da crise. Para mais informações, utilize este chat para interação. Evite contato com a equipe operacional por outros canais, a fim de não comprometer a gestão da ocorrência.\n\nOcorrência:\n@{triggerBody()?['text_5']}",
              "UserMessageWithOptionsSubscriptionRequest/body/messageTitle": "Acionamento - PLEM/PRAI"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
              "connectionName": "shared_teams",
              "operationId": "SubscribeUserMessageWithOptions"
            },
            "authentication": {
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
              "type": "Raw"
            }
          }
        },
        "Post_message_in_a_chat_or_channel-copy": {
          "runAfter": {
            "Postar_uma_escolha_de_opções": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "58baec2c-e106-4703-afcc-01e7c90394a4"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "poster": "Flow bot",
              "location": "Group chat",
              "body/recipient": "@triggerBody()?['text_6']",
              "body/messageBody": "<p class=\"editor-paragraph\">@{triggerBody()?['text_7']} &gt; @{triggerBody()?['text_2']} &gt; Respondeu ao Flow:</p><br><p class=\"editor-paragraph\">@{outputs('Postar_uma_escolha_de_opções')?['body/comments']}</p>"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
              "connectionName": "shared_teams",
              "operationId": "PostMessageToConversation"
            },
            "authentication": {
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
              "type": "Raw"
            }
          }
        },
        "Create_item2": {
          "runAfter": {
            "Post_message_in_a_chat_or_channel-copy": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "e187962a-ea13-4702-b638-8f31e210762a"
          },
          "type": "OpenApiConnection",
