              "table": "7fbfd875-2edd-4599-8603-90fec5c54333",
              "item/ID_acionamento": "@triggerBody()?['number_1']",
              "item/ID_entidade": "@triggerBody()?['number']",
              "item/ID_contato": "@triggerBody()?['number_2']",
              "item/ID_chat": "@triggerBody()?['text_6']",
              "item/Acao": "SEM RESPOSTA",
              "item/Atividade": "@{triggerBody()?['text_2']} > Sem resposta após 4 horas",
              "item/Hora": "@formatDateTime(convertFromUtc(utcNow(), 'E. South America Standard Time'), 'dd/MM/yyyy HH:mm:ss')",
              "item/Excluido": 0,
              "item/Ativo": 0
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
