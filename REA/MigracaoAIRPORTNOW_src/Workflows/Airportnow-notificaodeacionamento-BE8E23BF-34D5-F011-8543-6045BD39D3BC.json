              "id": "@triggerBody()?['number']",
              "item/Atividade2": "Sem resposta após 4 horas",
              "item/Hora2": "@formatDateTime(convertFromUtc(utcNow(), 'E. South America Standard Time'),'dd/MM/yyyy HH:mm')",
              "item/Status_2": "Sem resposta",
              "item/ID_acionamento": "@triggerBody()?['number_1']",
              "item/ID_contato": "@triggerBody()?['number_2']",
              "item/Excluido": false
            },
            "authentication": {
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
