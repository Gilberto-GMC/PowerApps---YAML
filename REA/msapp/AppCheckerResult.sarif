oAeronauticas.var_aprovarDescSede"}},"logicalLocations":[{"fullyQualifiedName":"ScreenOcorrenciasNaoAeronauticas.var_aprovarDescSede"}],"properties":{"module":"ScreenOcorrenciasNaoAeronauticas","type":"ScreenOcorrenciasNaoAeronauticas","member":"var_aprovarDescSede"}}],"properties":{"level":"Medium"}},{"ruleId":"app-UnusedVariables","ruleIndex":7,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"ScreenOcorrenciasNaoAeronauticas.var_editarDescAeroporto"}},"logicalLocations":[{"fullyQualifiedName":"ScreenOcorrenciasNaoAeronauticas.var_editarDescAeroporto"}],"properties":{"module":"ScreenOcorrenciasNaoAeronauticas","type":"ScreenOcorrenciasNaoAeronauticas","member":"var_editarDescAeroporto"}}],"properties":{"level":"Medium"}},{"ruleId":"app-UnusedVariables","ruleIndex":7,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"ScreenOcorrenciasNaoAeronauticas.var_editarDescSede"}},"logicalLocations":[{"fullyQualifiedName":"ScreenOcorrenciasNaoAeronauticas.var_editarDescSede"}],"properties":{"module":"ScreenOcorrenciasNaoAeronauticas","type":"ScreenOcorrenciasNaoAeronauticas","member":"var_editarDescSede"}}],"properties":{"level":"Medium"}},{"ruleId":"app-UnusedVariables","ruleIndex":7,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"ScreenOcorrenciasNaoAeronauticas.var_erroExclusao"}},"logicalLocations":[{"fullyQualifiedName":"ScreenOcorrenciasNaoAeronauticas.var_erroExclusao"}],"properties":{"module":"ScreenOcorrenciasNaoAeronauticas","type":"ScreenOcorrenciasNaoAeronauticas","member":"var_erroExclusao"}}],"properties":{"level":"Medium"}},{"ruleId":"app-UnusedVariables","ruleIndex":7,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"ScreenOcorrenciasNaoAeronauticas.var_novaVersao"}},"logicalLocations":[{"fullyQualifiedName":"ScreenOcorrenciasNaoAeronauticas.var_novaVersao"}],"properties":{"module":"ScreenOcorrenciasNaoAeronauticas","type":"ScreenOcorrenciasNaoAeronauticas","member":"var_novaVersao"}}],"properties":{"level":"Medium"}},{"ruleId":"app-CountRowsGalleryAllItems","ruleIndex":14,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"ScreenOcorrenciasNaoAeronauticas.ScreenContainerDinamicHome_9.BottomContainer1_10.Container44_3.Container40_4.Container113_2.HtmlText3_3.HtmlText"}},"logicalLocations":[{"fullyQualifiedName":"ScreenOcorrenciasNaoAeronauticas.ScreenContainerDinamicHome_9.BottomContainer1_10.Container44_3.Container40_4.Container113_2.HtmlText3_3.HtmlText"}],"properties":{"module":"ScreenOcorrenciasNaoAeronauticas","type":"ScreenOcorrenciasNaoAeronauticas.ScreenContainerDinamicHome_9.BottomContainer1_10.Container44_3.Container40_4.Container113_2.HtmlText3_3","member":"HtmlText"}}],"properties":{"level":"Medium"}},{"ruleId":"app-ForAllWithMutation","ruleIndex":13,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"ScreenPainelOperacional_new.ScreenContainer2_2.Container16_2.TimerRefresh_1.OnTimerEnd"}},"logicalLocations":[{"fullyQualifiedName":"ScreenPainelOperacional_new.ScreenContainer2_2.Container16_2.TimerRefresh_1.OnTimerEnd"}],"properties":{"module":"ScreenPainelOperacional_new","type":"ScreenPainelOperacional_new.ScreenContainer2_2.Container16_2.TimerRefresh_1","member":"OnTimerEnd"}}],"properties":{"level":"Medium"}}],"tool":{"driver":{"name":"PowerApps app checker","fullName":"PowerApps app checker","version":"1.349","rules":[{"id":"app-SuggestRemoteExecutionHint","messageStrings":{"issue":{"text":"Delegation warning. The \"{0}\" part of this formula might not work correctly on large data sets."}},"properties":{"howToFix":["If your data set exceeds the 500 record limit but contains less than 2,000 records, try resetting the limit.","Try simplifying the formula.","Try moving your data to a different data source."],"whyFix":"","level":"Medium","componentType":"app","primaryCategory":"formula"}},{"id":"app-WarnInvalidTypeForVariableDefinition","messageStrings":{"issue":{"text":"The variable {0} needs to have a non-Blank type. If this is the only place that {0} is defined, resolve this by adding another definition elsewhere that assigns a non-Blank value to this variable."}},"properties":{"whyFix":"","level":"Medium","componentType":"app","primaryCategory":"formula"}},{"id":"app-ErrIncompatibleTypesForEquality-Left-Right","messageStrings":{"issue":{"text":"Incompatible types for comparison. These types can't be compared: {0}, {1}."}},"properties":{"howToFix":["You might need to convert the value to be the same type, such as converting a date string (e.g., \"12/31/2018\") to a date value.","If you're comparing records or tables, the field or column types must match exactly."],"whyFix":"","level":"Medium","componentType":"app","primaryCategory":"formula"}},{"id":"app-SuggestRemoteExecutionHint-OpNotSupportedByColumn","messageStrings":{"issue":{"text":"Delegation warning. The highlighted part of this formula might not work correctly with column \"{0}\" on large data sets."}},"properties":{"howToFix":["If your data set exceeds the 500 record limit but contains less than 2,000 records, try resetting the limit.","Try simplifying the formula.","Try moving your data to a different data source."],"whyFix":"","level":"Medium","componentType":"app","primaryCategory":"formula"}},{"id":"acc-AccessibleLabelNeeded","messageStrings":{"issue":{"text":"Missing accessible label"}},"properties":{"howToFix":["Edit the accessible label property to describe the item."],"whyFix":"If there's no accessible text, people who can’t see the screen won't understand what’s in images and controls.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"acc-TabIndexShouldBeDefinedForInteractiveControl","messageStrings":{"issue":{"text":"Missing tab stop"}},"properties":{"howToFix":["Set TabIndex to 0 or greater to ensure that interactive elements have a tab stop."],"whyFix":"People who use the keyboard with your app will not be able to access this element without a tab stop.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"acc-FocusBorderShouldBeVisible","messageStrings":{"issue":{"text":"Focus isn't showing"}},"properties":{"howToFix":["Change the FocusedBorderThickness property to be more than 0."],"whyFix":"If the focus isn't visible, people who don't use a mouse won't be able to see it when they're interacting with the app.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"app-UnusedVariables","messageStrings":{"issue":{"text":"Variável não usada"}},"properties":{"howToFix":["Remover a variável não usada."],"whyFix":"Essa variável está declarada, mas não é referenciada por nenhum controle, portanto não é necessária.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-UnusedMediaResources","messageStrings":{"issue":{"text":"Arquivos de mídia não utilizados"}},"properties":{"howToFix":["Remova o arquivo de mídia não utilizado no painel Mídia."],"whyFix":"Este arquivo de mídia não é referenciado por nenhuma fórmula de controle, portanto não é necessário. Sua remoção melhorará o desempenho.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-CollectDelegatableDataSource","messageStrings":{"issue":{"text":"As linhas recuperadas da fonte de dados podem não estar completas."}},"properties":{"howToFix":["Limite os dados coletados da fonte de dados atualizando a fórmula \"ClearCollect(col_painelOperacionalVeiculos; tbl_gestaoVeiculosRea)\" para incluir uma função de filtragem, como 'Filter' ou 'Search'."],"whyFix":"O uso da função 'Collect' para criar uma coleção diretamente de uma fonte de dados conectada poderá não carregar todas as linhas se a fonte de dados for muito grande.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-CollectingReadOnlyTable","messageStrings":{"issue":{"text":"A coleção foi inicializada, mas nunca atualizada"}},"properties":{"howToFix":["Substitua Collect ou ClearCollect por uma fórmula nomeada no App.Formulas. Por exemplo, MyTable = Filter(source, condition). Fórmulas nomeadas são calculadas quando suas entradas mudam e não têm o custo de acompanhamento de uma coleção."],"whyFix":"Coleções são feitas para serem atualizadas. O Power Apps faz um trabalho adicional para acompanhar cada coleção, garantindo que tudo que dependa dela fique sincronizado quando os dados mudam. Quando os dados não mudam depois de configurados, esse trabalho de acompanhamento é desperdiçado. Uma fórmula nomeada fornece os mesmos dados sem esse custo adicional.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-ScreenHasManyControls","messageStrings":{"issue":{"text":"Muitos controles em uma tela"}},"properties":{"howToFix":["Reduza o número de controles na tela.","Divida o aplicativo em mais telas para reduzir a complexidade por tela.","Use componentes para unificar os controles agrupados que são idênticos entre telas, reduzindo a duplicação.","Use galerias para representar uma série de controles semelhantes repetidos.","Divida o aplicativo em vários aplicativos para que cada aplicativo seja pequeno e tenha maior desempenho."],"whyFix":"Cada controle consome recursos e, quando uma tela tem muitos controles, o aplicativo pode ficar lento ou parar de responder. A complexidade estimada de \"ScreenCheckListREA\" é 717, o que excede o limite máximo recomendado (300).","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-InefficientDelayLoading","messageStrings":{"issue":{"text":"Carregamento de atraso ineficiente"}},"properties":{"howToFix":["Ao invés disso, use variáveis, coleções e contexto de navegação para compartilhar o estado nas telas."],"whyFix":"Os controles que referenciam controles em outras telas podem deixar o carregamento do aplicativo e a navegação mais lentos. Isso força o aplicativo a carregar as outras telas imediatamente, em vez de aguardar até que o usuário navegue para elas.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-ForAllWithMutation","messageStrings":{"issue":{"text":"Modificar uma coleção ou fonte de dados dentro do ForAll pode causar uma reavaliação excessiva das regras"}},"properties":{"howToFix":["Como o ForAll retorna uma tabela, passe seu resultado como entrada para a função de mutação em uma única chamada em lote. Por exemplo, substitua ForAll(source, Collect(c, { ... })) por Collect(c, ForAll(source, { ... })); o mesmo padrão vale para Patch e Remove. Uma única mutação em lote emite uma notificação de mudança em vez de uma por iteração.","Para atualizações ou exclusões triviais por linha em uma fonte de dados, prefira as funções delegáveis UpdateIf ou RemoveIf chamadas uma vez fora do ForAll, em vez de iterar com ForAll."],"whyFix":"Usar Collect, Patch, Remove ou outra função de mutação dentro do corpo do ForAll altera a fonte de dados ou a coleção alvo uma vez por iteração. Cada propriedade de controle que depende dessa coleção ou fonte de dados é reavaliada a cada mutação, o que pode transformar um pequeno loop em milhares de avaliações de regras e, para fontes de dados conectadas, em uma solicitação de rede por linha.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-CountRowsGalleryAllItems","messageStrings":{"issue":{"text":"Use AllItemsCount em vez de CountRows com AllItems"}},"properties":{"howToFix":["Substitua CountRows(Gallery.AllItems) por Gallery.AllItemsCount para melhor desempenho."],"whyFix":"Usar CountRows com a propriedade AllItems de uma galeria força a criação de uma tabela de saída que contém uma cópia da fonte de dados de entrada e o estado atual de todos os controles filhos. Isso pode forçar a inicialização de linhas não inicializadas, consumindo ciclos extras de CPU, memória e potencialmente gerando solicitações de rede por linha.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-IndexedAccessViaCopy","messageStrings":{"issue":{"text":"Use Index para ler um registro em uma posição específica"}},"properties":{"howToFix":["Substitua Last(FirstN(t, n)) por Index(t, Min(CountRows(t), n)) — t e n permanecem iguais à sua expressão original. O Min mantém o comportamento original — quando n está no intervalo, retorna a enésima linha, e quando n é maior que a contagem de linhas, retorna a última linha em vez de um erro. Se você já sabe que n está entre 1 e CountRows(t), pode simplificar para Index(t, n).","Substitua First(LastN(t, n)) por Index(t, Max(1, CountRows(t) - n + 1)) — t e n permanecem iguais à sua expressão original. O Max mantém o comportamento original — quando n está no intervalo, retorna a enésima linha a partir do fim, e quando n é maior que a contagem de linhas, retorna a primeira linha em vez de um erro. Se você já sabe que n está entre 1 e CountRows(t), pode simplificar para Index(t, CountRows(t) - n + 1)."],"whyFix":"Em expressões como Last(FirstN(t, n)) e First(LastN(t, n)) — onde t é a tabela e n é a posição da linha — ambas as formas criam uma cópia da tabela até n linhas só para retornar um registro no marco de delimitação. Index(t, ...) retorna o registro na posição diretamente, sem criar essa cópia intermediária, evitando o custo da cópia e o trabalho por linha que ela geraria. Quando n está entre 1 e a contagem de linhas de t (os identificadores t e n devem permanecer os mesmos da sua expressão original), as duas formas retornam o mesmo registro; quando n ultrapassa a contagem de linhas, Index gera erro, enquanto as formas com FirstN/LastN retornam a linha do marco de delimitação. Então, use uma fórmula de limite como Min(CountRows(t), n) se seus dados podem ser menores que n.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-CrossScreenEventDependencies","messageStrings":{"issue":{"text":"A regra de evento faz referência a um controle em outra tela"}},"properties":{"howToFix":["Mova o trabalho para um evento na tela proprietária (por exemplo, Screen.OnVisible), ou passe o estado entre telas usando o parâmetro de contexto do Navigate ou uma variável global e reaja a ele na tela de destino."],"whyFix":"Regras de eventos (como OnStart, OnVisible e OnSelect) que fazem referência a controles em outras telas forçam essas telas a carregar e inicializar mais cedo, mesmo que o usuário nunca navegue até elas. Isso pode deixar o início e a navegação do aplicativo visivelmente mais lentos.","componentType":"app","primaryCategory":"performance","level":"Medium"}}]}},"invocations":[{"executionSuccessful":true}],"columnKind":"utf16CodeUnits"}]}